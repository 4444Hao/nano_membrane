# EditorConfig 帮助开发者在不同编辑器和 IDE 中保持一致的编码风格
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,yaml,yml,json,md,txt}]
charset = utf-8
indent_style = space
indent_size = 4

[*.{yaml,yml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
